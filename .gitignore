!/THIRD_PARTY_NOTICES.md
!/config.example.json
!/requirements.txt
!/app.py
!/comfy_pool.py
!/index.html
!/start_windows.bat
!/start_team.bat
!/debug_windows.bat
!/start_ubuntu.sh
!/push_updates.bat
!/update.bat
!/push_updates.sh
!/update.sh
!/agents/
!/core/
!/infrastructure/
!/skills/
!/static/
!/team/
!/tests/
!/workflows/
!/docs/

# Runtime data and private settings, including nested copies.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.sqlite*
*.db
*.db-*
*.log
*.tmp
*.bak
*.pem
*.key
*.p12
*.pfx
*.exe
*.dll
*.zip
